# ============================================================================
# Local development configuration -- copy to .env and adjust.
#
#   cp .env.example .env
#
# .env is git-ignored and must never be committed. The values below are obvious
# placeholders for local use only; the application refuses to start in staging or
# production while a placeholder is still in place (see core/config.py).
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# local | ci | staging | production
ENVIRONMENT=local
DEBUG=false

LOG_LEVEL=INFO
# json for machine-parseable output, console for readable local output
LOG_FORMAT=console

# Origins allowed to call the API with credentials. No wildcards.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Ranking ingestion, display and filtering. Off until an authorised ranking source
# is licensed (architecture decision D8).
RANKINGS_ENABLED=false

# Include the S3/MinIO evidence store in /health/ready. Enable once you rely on it.
READINESS_CHECK_OBJECT_STORAGE=false
READINESS_TIMEOUT_SECONDS=5.0

# ---------------------------------------------------------------------------
# PostgreSQL -- four separate identities (architecture correction C11)
#
# There is deliberately NO shared application user. Each service connects as its
# own role, and the settings layer refuses any configuration where a service uses
# the schema-owning role. Privileges land with the Step 3 domain migrations; the
# identities exist now so nothing is ever written against the owner by default.
# See infra/postgres/README.md.
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datahub

# --- Schema owner / migration role -----------------------------------------
# Creates and owns schema objects; used by Alembic ONLY, never by a service.
# POSTGRES_USER / POSTGRES_PASSWORD are what the postgres container itself needs,
# and must match the migration pair below.
POSTGRES_USER=datahub
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_MIGRATION_USER=datahub
POSTGRES_MIGRATION_PASSWORD=local_dev_only_change_me

# --- app_api: request handling. Owns nothing. ------------------------------
POSTGRES_API_USER=app_api
POSTGRES_API_PASSWORD=local_dev_only_change_me_api

# --- app_worker: Celery workers. Owns nothing. -----------------------------
POSTGRES_WORKER_USER=app_worker
POSTGRES_WORKER_PASSWORD=local_dev_only_change_me_worker

# --- app_publisher: the publication transaction only. ----------------------
# The only identity that will hold canonical projection writes.
POSTGRES_PUBLISHER_USER=app_publisher
POSTGRES_PUBLISHER_PASSWORD=local_dev_only_change_me_publisher

# Consumed by infra/postgres/init/10-runtime-roles.sh when the database is first
# created, and by the integration test fixtures. Keep each value identical to the
# matching POSTGRES_*_PASSWORD above.
APP_API_PASSWORD=local_dev_only_change_me_api
APP_WORKER_PASSWORD=local_dev_only_change_me_worker
APP_PUBLISHER_PASSWORD=local_dev_only_change_me_publisher

# TLS for every database connection. Leave unset for a local container on a
# loopback interface. REQUIRED by every managed provider (Neon, Supabase, RDS):
# without it asyncpg does not attempt TLS at all and the server refuses the
# connection. libpq vocabulary: disable | allow | prefer | require | verify-ca |
# verify-full. One setting, but the two drivers spell it differently in the DSN
# (psycopg takes sslmode, asyncpg takes ssl), so the config layer translates it --
# see SSL_QUERY_PARAMETER in core/config.py.
# POSTGRES_SSLMODE=require

POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
POSTGRES_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Celery -- defaults to the Redis settings above when unset
# ---------------------------------------------------------------------------
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# Beat schedules in Beijing time; stored timestamps are always UTC.
CELERY_SCHEDULER_TIMEZONE=Asia/Shanghai
CELERY_TASK_TIME_LIMIT_SECONDS=900
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=840

# ---------------------------------------------------------------------------
# Object storage (MinIO locally, S3 in deployed environments)
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
# Also the MinIO root credentials in docker-compose. CHANGE THESE.
S3_ACCESS_KEY_ID=local_dev_only_change_me
S3_SECRET_ACCESS_KEY=local_dev_only_change_me
S3_EVIDENCE_BUCKET=datahub-evidence
# Required by MinIO; harmless against real S3.
S3_USE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# The reviewer console
# ---------------------------------------------------------------------------
# The console is a SEPARATE REPOSITORY and a separate deployment, and it holds no
# database credential: it forwards browser requests to this API server-side. Its
# own API_BASE_URL points at wherever this API publishes, and it is configured in
# that repository, not here.
#
# What this API must be told about it is which origins may call with credentials:
# CORS_ALLOWED_ORIGINS above. No wildcards -- a wildcard cannot carry cookies, and
# the console's session depends on them.

# ---------------------------------------------------------------------------
# Host port mappings (all bound to 127.0.0.1 by docker-compose)
# ---------------------------------------------------------------------------
API_PORT=8000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Integration tests -- set to run the tests marked `integration`, which skip
# themselves when these are absent.
# ---------------------------------------------------------------------------
# The DSN uses the migration/owner role: the tests create and drop scratch
# databases. Per-role checks read the APP_*_PASSWORD values above.
# DATAHUB_TEST_POSTGRES_DSN=postgresql+psycopg://datahub:local_dev_only_change_me@localhost:5432/datahub
# DATAHUB_TEST_REDIS_URL=redis://localhost:6379/1

# --- Reviewer console -------------------------------------------------------
# Signs preview tokens for the reviewer console. NOT a session store: sessions are
# rows in `user_session`, hashed, so revocation is immediate. This key is what makes
# a preview token unforgeable, so a placeholder here would let anyone who has read
# this file mint a "confirm" for a decision nobody previewed. Deployed environments
# refuse to start with the default value.
#   generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me

# How long a browser session lasts, and how long a preview stays applicable. The
# preview window is short on purpose: it is a statement about the database as it
# was, and the longer it is honoured the less true it is.
SESSION_TTL_MINUTES=480
PREVIEW_TTL_SECONDS=900

# Where the normalised document artifacts live. The evidence viewer reads stored
# bytes from here and never refetches, so a reviewer judges what the system holds.
ARTIFACT_ROOT=.artifacts-full

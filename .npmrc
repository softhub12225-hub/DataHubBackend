# Refuse to install or run under a Node or pnpm version the project does not target,
# using the `engines` field in package.json.
#
# This is an error rather than a warning on purpose: local-vs-CI Node divergence is
# cheap to prevent and expensive to diagnose, and the failure it causes (a build that
# works on one machine and not another) wastes the most time of anything in this
# category.
engine-strict=true
